# Environment Configuration Template for SurgMLLM / ZWZ
# Copy this file to configs/api_key.env or export variables directly:
# cp configs/api_key.env.example configs/api_key.env

# Google Gemini API Key (used by Teacher Oracle in Step 03)
# GENAI_API_KEY="your_gemini_api_key_here"
# GOOGLE_API_KEY="your_gemini_api_key_here"

# Hugging Face Access Token (used for downloading datasets and benchmarks)
# HF_TOKEN="your_huggingface_token_here"

# Path Overrides (Optional - defaults to project relative directories)
# MODEL_PATH="/workspace/Qwen-VL"
# DATA_PATH="./output/dsyn_training_set.jsonl"
# SAVE_DIR="./weights/checkpoints1"
# FINAL_DIR="./weights/qwen_lora_final"
